        </mxCell>
        <mxCell id="constraint-1" value="블록구성의 (도전번호, 블록유형) 조합은 중복될 수 없다. 블록유형은 여섯 가지로 제한한다." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=23;fontColor=#000000;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="270" y="1308" width="1740" height="42" as="geometry" />
        </mxCell>
        <mxCell id="constraint-2" value="첫 도전의 이전도전번호는 NULL(값 없음)이다. 이전 도전은 같은 회원의 같은 미션이어야 한다." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=23;fontColor=#000000;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1">
